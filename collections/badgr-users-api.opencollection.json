{
  "opencollection": "1.0.0",
  "info": {
    "name": "Badgr Assertions Users API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.badgr.io/o/authorize",
      "accessTokenUrl": "https://api.badgr.io/o/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the authenticated user's profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.badgr.io/v2/users/self"
          },
          "docs": "Get the authenticated user's profile"
        },
        {
          "info": {
            "name": "Update the authenticated user's profile",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.badgr.io/v2/users/self"
          },
          "docs": "Update the authenticated user's profile"
        },
        {
          "info": {
            "name": "Get a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.badgr.io/v2/users/:entityId",
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a user"
        },
        {
          "info": {
            "name": "Update a user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.badgr.io/v2/users/:entityId",
            "params": [
              {
                "name": "entityId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a user"
        },
        {
          "info": {
            "name": "Get the latest terms of service version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.badgr.io/v2/termsVersions/latest"
          },
          "docs": "Get the latest terms of service version"
        }
      ]
    }
  ],
  "bundled": true
}