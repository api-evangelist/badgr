{
  "info": {
    "name": "Badgr API",
    "description": "Badgr open digital badging platform (Instructure Canvas Credentials), implementing the Open Badges standard. Core server is open source (github.com/concentricsky/badgr-server, GNU AGPL-3.0). Base URL: https://api.badgr.io/v2 (regional: api.eu.badgr.io, api.ca.badgr.io, api.au.badgr.io). Auth is OAuth2 bearer token from /o/token with scopes rw:profile rw:issuer rw:backpack.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.badgr.io", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "issuerId", "value": "", "type": "string" },
    { "key": "badgeClassId", "value": "", "type": "string" },
    { "key": "assertionId", "value": "", "type": "string" },
    { "key": "collectionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Obtain access token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "username", "value": "you@example.com" },
              { "key": "password", "value": "" },
              { "key": "scope", "value": "rw:profile rw:issuer rw:backpack" }
            ] },
            "url": { "raw": "{{baseUrl}}/o/token", "host": ["{{baseUrl}}"], "path": ["o", "token"] },
            "description": "Exchange credentials (or a refresh token) for an OAuth2 bearer access token."
          }
        },
        {
          "name": "List access tokens",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/auth/tokens", "host": ["{{baseUrl}}"], "path": ["v2", "auth", "tokens"] },
            "description": "List application access tokens for the authenticated user."
          }
        },
        {
          "name": "Revoke access token",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/auth/tokens/:entityId", "host": ["{{baseUrl}}"], "path": ["v2", "auth", "tokens", ":entityId"], "variable": [{ "key": "entityId", "value": "" }] },
            "description": "Revoke a specific access token."
          }
        }
      ]
    },
    {
      "name": "Issuers",
      "item": [
        {
          "name": "List issuers",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/issuers", "host": ["{{baseUrl}}"], "path": ["v2", "issuers"] },
            "description": "List issuers the authenticated user can access."
          }
        },
        {
          "name": "Create issuer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Example Issuer\",\n  \"description\": \"An example badge issuer\",\n  \"url\": \"https://example.com\",\n  \"email\": \"badges@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/v2/issuers", "host": ["{{baseUrl}}"], "path": ["v2", "issuers"] },
            "description": "Create a new issuer."
          }
        },
        {
          "name": "Get issuer",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/issuers/{{issuerId}}", "host": ["{{baseUrl}}"], "path": ["v2", "issuers", "{{issuerId}}"] },
            "description": "Retrieve a single issuer by entityId."
          }
        },
        {
          "name": "Update issuer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Example Issuer (updated)\"\n}" },
            "url": { "raw": "{{baseUrl}}/v2/issuers/{{issuerId}}", "host": ["{{baseUrl}}"], "path": ["v2", "issuers", "{{issuerId}}"] },
            "description": "Update an issuer."
          }
        },
        {
          "name": "Delete issuer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/issuers/{{issuerId}}", "host": ["{{baseUrl}}"], "path": ["v2", "issuers", "{{issuerId}}"] },
            "description": "Delete an issuer."
          }
        },
        {
          "name": "List issuer badge classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/issuers/{{issuerId}}/badgeclasses", "host": ["{{baseUrl}}"], "path": ["v2", "issuers", "{{issuerId}}", "badgeclasses"] },
            "description": "List badge classes belonging to an issuer."
          }
        },
        {
          "name": "List issuer assertions",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/issuers/{{issuerId}}/assertions", "host": ["{{baseUrl}}"], "path": ["v2", "issuers", "{{issuerId}}", "assertions"] },
            "description": "List all assertions awarded by an issuer."
          }
        }
      ]
    },
    {
      "name": "BadgeClasses",
      "item": [
        {
          "name": "List all badge classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/badgeclasses", "host": ["{{baseUrl}}"], "path": ["v2", "badgeclasses"] },
            "description": "List all badge classes visible to the user."
          }
        },
        {
          "name": "Create badge class under issuer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Example Badge\",\n  \"description\": \"Awarded for completing the example\",\n  \"image\": \"data:image/png;base64,...\",\n  \"criteriaNarrative\": \"Complete the example task.\"\n}" },
            "url": { "raw": "{{baseUrl}}/v2/issuers/{{issuerId}}/badgeclasses", "host": ["{{baseUrl}}"], "path": ["v2", "issuers", "{{issuerId}}", "badgeclasses"] },
            "description": "Create a badge class under an issuer."
          }
        },
        {
          "name": "Get badge class",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/badgeclasses/{{badgeClassId}}", "host": ["{{baseUrl}}"], "path": ["v2", "badgeclasses", "{{badgeClassId}}"] },
            "description": "Retrieve a badge class by entityId."
          }
        },
        {
          "name": "Update badge class",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated description\"\n}" },
            "url": { "raw": "{{baseUrl}}/v2/badgeclasses/{{badgeClassId}}", "host": ["{{baseUrl}}"], "path": ["v2", "badgeclasses", "{{badgeClassId}}"] },
            "description": "Update a badge class."
          }
        },
        {
          "name": "Delete badge class",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/badgeclasses/{{badgeClassId}}", "host": ["{{baseUrl}}"], "path": ["v2", "badgeclasses", "{{badgeClassId}}"] },
            "description": "Delete a badge class."
          }
        }
      ]
    },
    {
      "name": "Assertions",
      "item": [
        {
          "name": "List badge class assertions",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/badgeclasses/{{badgeClassId}}/assertions", "host": ["{{baseUrl}}"], "path": ["v2", "badgeclasses", "{{badgeClassId}}", "assertions"] },
            "description": "List assertions of a badge class."
          }
        },
        {
          "name": "Issue assertion",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"recipient\": {\n    \"identity\": \"earner@example.com\",\n    \"type\": \"email\",\n    \"hashed\": true\n  },\n  \"narrative\": \"Awarded for outstanding work.\"\n}" },
            "url": { "raw": "{{baseUrl}}/v2/badgeclasses/{{badgeClassId}}/assertions", "host": ["{{baseUrl}}"], "path": ["v2", "badgeclasses", "{{badgeClassId}}", "assertions"] },
            "description": "Issue (award) an assertion of a badge class to a recipient."
          }
        },
        {
          "name": "Batch issue assertions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"assertions\": [\n    { \"recipient\": { \"identity\": \"a@example.com\", \"type\": \"email\", \"hashed\": true } }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/v2/badgeclasses/{{badgeClassId}}/issue", "host": ["{{baseUrl}}"], "path": ["v2", "badgeclasses", "{{badgeClassId}}", "issue"] },
            "description": "Batch issue multiple assertions of a badge class."
          }
        },
        {
          "name": "Get assertion",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/assertions/{{assertionId}}", "host": ["{{baseUrl}}"], "path": ["v2", "assertions", "{{assertionId}}"] },
            "description": "Retrieve an assertion by entityId."
          }
        },
        {
          "name": "Revoke assertion",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/assertions/{{assertionId}}", "host": ["{{baseUrl}}"], "path": ["v2", "assertions", "{{assertionId}}"] },
            "description": "Revoke an assertion."
          }
        },
        {
          "name": "Batch revoke assertions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"assertions\": [\n    { \"entityId\": \"{{assertionId}}\", \"revocationReason\": \"Issued in error\" }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/v2/assertions/revoke", "host": ["{{baseUrl}}"], "path": ["v2", "assertions", "revoke"] },
            "description": "Batch revoke multiple assertions."
          }
        }
      ]
    },
    {
      "name": "Backpack",
      "item": [
        {
          "name": "List backpack assertions",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/backpack/assertions", "host": ["{{baseUrl}}"], "path": ["v2", "backpack", "assertions"] },
            "description": "List badges held in the authenticated earner's backpack."
          }
        },
        {
          "name": "Import external badge",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://example.org/assertion.json\"\n}" },
            "url": { "raw": "{{baseUrl}}/v2/backpack/import", "host": ["{{baseUrl}}"], "path": ["v2", "backpack", "import"] },
            "description": "Import an external Open Badge into the backpack."
          }
        },
        {
          "name": "Share backpack assertion",
          "request": {
            "method": "PUT",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/backpack/share/assertion/{{assertionId}}", "host": ["{{baseUrl}}"], "path": ["v2", "backpack", "share", "assertion", "{{assertionId}}"] },
            "description": "Create a public share URL for a backpack assertion."
          }
        }
      ]
    },
    {
      "name": "Collections",
      "item": [
        {
          "name": "List collections",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/backpack/collections", "host": ["{{baseUrl}}"], "path": ["v2", "backpack", "collections"] },
            "description": "List the earner's collections."
          }
        },
        {
          "name": "Create collection",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"My Achievements\",\n  \"description\": \"A curated set of badges\"\n}" },
            "url": { "raw": "{{baseUrl}}/v2/backpack/collections", "host": ["{{baseUrl}}"], "path": ["v2", "backpack", "collections"] },
            "description": "Create a collection."
          }
        },
        {
          "name": "Get collection",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/backpack/collections/{{collectionId}}", "host": ["{{baseUrl}}"], "path": ["v2", "backpack", "collections", "{{collectionId}}"] },
            "description": "Retrieve a collection by entityId."
          }
        },
        {
          "name": "Delete collection",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/backpack/collections/{{collectionId}}", "host": ["{{baseUrl}}"], "path": ["v2", "backpack", "collections", "{{collectionId}}"] },
            "description": "Delete a collection."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get own profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v2/users/self", "host": ["{{baseUrl}}"], "path": ["v2", "users", "self"] },
            "description": "Retrieve the authenticated user's profile."
          }
        },
        {
          "name": "Update own profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Kin\",\n  \"lastName\": \"Lane\"\n}" },
            "url": { "raw": "{{baseUrl}}/v2/users/self", "host": ["{{baseUrl}}"], "path": ["v2", "users", "self"] },
            "description": "Update the authenticated user's profile."
          }
        }
      ]
    }
  ]
}
